# Install target. The installer should be run from the cloned repository.
APP_DIR=/opt/mapdr-project
APP_USER=root

# Public routing
PUBLIC_HOST=pacs.example.com
PUBLIC_SCHEME=https
NGINX_LISTEN=80
FRONTEND_PORT=8081
API_PORT=3001
AUTH_API_PORT=8788
VIDEO_GATEWAY_PORT=8787
VITE_API=/api
VITE_AUTH_API=/auth-api
VITE_VIDEO_API=/video-api
VITE_DICOM_UPLOAD_BATCH_SIZE=500
VITE_DICOM_UPLOAD_BATCH_MAX_MB=75
VITE_DICOM_UPLOAD_TIMEOUT_MS=600000

# Docker PACS/OHIF
DICOM_BIND_IP=0.0.0.0
DICOM_PORT=4242
ORTHANC_HTTP_PORT=8042
OHIF_PORT=3000

# Orthanc credentials. Keep these in sync with docker/ohif-orthanc/orthanc.json.
ORTHANC_USERNAME=admin
ORTHANC_PASSWORD=change-me

# API
NODE_ENV=production
UPLOAD_MAX_MB=5120
UPLOAD_MAX_FILES=2000
DICOM_IN_MEMORY_MAX_MB=64
DICOM_UPLOAD_CONCURRENCY=8
ORTHANC_UPLOAD_TIMEOUT_MS=300000
ORTHANC_UPLOAD_RETRIES=2
CORS_ALLOWED_ORIGINS=https://pacs.example.com
APP_BASE_URL=https://pacs.example.com
OHIF_HOST=https://pacs.example.com
SERVER_IP=127.0.0.1
NEXTCLOUD_URL=
NEXTCLOUD_USERNAME=
NEXTCLOUD_PASSWORD=
NEXTCLOUD_REJECT_UNAUTHORIZED=true
DELETED_STUDY_RETENTION_DAYS=7
DELETED_STUDY_SWEEP_INTERVAL_MS=3600000
ORTHANC_DELETE_RECONCILE_INTERVAL_MS=900000

# Auth API
AUTH_SESSION_COOKIE=mediview_session
AUTH_SESSION_TTL_HOURS=24
AUTH_COOKIE_SECURE=true
AUTH_BOOTSTRAP_ADMIN_PASSWORD=replace-with-a-long-random-admin-password

# Video gateway / LiveKit
LIVEKIT_URL=auto
LIVEKIT_API_KEY=mediviewkey
LIVEKIT_API_SECRET=replace-with-a-long-random-secret
TOKEN_TTL_SECONDS=3600
