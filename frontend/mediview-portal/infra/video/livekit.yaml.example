port: 7880
log_level: info

rtc:
  tcp_port: 7881
  port_range_start: 50000
  port_range_end: 50100
  use_external_ip: true

redis:
  address: 127.0.0.1:6379

keys:
  {{LIVEKIT_API_KEY}}: {{LIVEKIT_API_SECRET}}

turn:
  # Enable only after mounting valid TURN TLS certificate files.
  enabled: false
