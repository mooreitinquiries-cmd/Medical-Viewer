AUTH_API_PORT=8788
AUTH_API_CORS_ORIGIN=http://localhost:8080
AUTH_SESSION_COOKIE=mediview_session
AUTH_SESSION_TTL_HOURS=8760
AUTH_BOOTSTRAP_ADMIN_PASSWORD=replace-with-a-long-random-admin-password

# End-user email two-factor authentication framework.
# Leave disabled until the login UI and Resend sender are ready.
TWO_FACTOR_AUTH_ENABLED=false
TWO_FACTOR_CODE_SECRET=replace-with-a-long-random-secret
TWO_FACTOR_CODE_TTL_MINUTES=10
TWO_FACTOR_CODE_MAX_ATTEMPTS=5
TWO_FACTOR_APP_NAME=MAPDR
TWO_FACTOR_RESEND_API_KEY=
TWO_FACTOR_RESEND_FROM=

# In-memory auth throttles. Use a shared external limiter if auth runs on multiple instances.
AUTH_LOGIN_RATE_LIMIT_MAX=10
AUTH_LOGIN_RATE_LIMIT_WINDOW_MS=900000
TWO_FACTOR_SEND_RATE_LIMIT_MAX=3
TWO_FACTOR_SEND_RATE_LIMIT_WINDOW_MS=600000
TWO_FACTOR_VERIFY_RATE_LIMIT_MAX=8
TWO_FACTOR_VERIFY_RATE_LIMIT_WINDOW_MS=600000

# Private white-label subscription signup.
# Signup routes are token-gated; generate links from the authenticated white-label admin page.
WHITE_LABEL_SIGNUP_TOKEN_TTL_DAYS=14
WHITE_LABEL_OPERATIONS_EMAIL=operations@octelerad.com
WHITE_LABEL_SELF_DOWNLOAD_PRICE_PER_DOCTOR=249
WHITE_LABEL_HOSTED_RETENTION_PRICE_PER_DOCTOR=499
# WordPress checkout URL. The auth API appends accountId, plan, doctorSeats,
# pricePerDoctorMonthly, monthlyPrice, billingEmail, callbackUrl, and returnUrl.
# You can also use placeholders like {accountId}, {plan}, {doctorSeats}, {monthlyPrice}.
WHITE_LABEL_WORDPRESS_PAYMENT_URL=
# Backward-compatible alias if you are not using the WordPress-specific name.
WHITE_LABEL_PAYMENT_SETUP_URL=
# Shared secret WordPress must send as JSON field "secret" to /white-label/payment-callback.
WHITE_LABEL_PAYMENT_CALLBACK_SECRET=replace-with-a-long-random-shared-secret
