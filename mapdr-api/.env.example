# Runtime
NODE_ENV=production
PORT=3001
JSON_LIMIT=2mb
HTTP_TIMEOUT_MS=15000
ORTHANC_UPLOAD_TIMEOUT_MS=300000
ORTHANC_UPLOAD_RETRIES=2
UPLOAD_MAX_MB=5120
UPLOAD_MAX_FILES=2000
DICOM_IN_MEMORY_MAX_MB=64
DICOM_UPLOAD_CONCURRENCY=8
SHARE_TTL_DAYS=7

# Public URLs
# Optional: if set, used by /api/viewer-link/:id
APP_BASE_URL=
OHIF_HOST=
SERVER_IP=127.0.0.1

# Optional: if set, /api/viewer-link/:id will open the external PACS instead of local OHIF.
# Typical reverse-proxy path: https://this-app.example.com/external-pacs
EXTERNAL_PACS_BASE_URL=
# Optional route under the external PACS base, for example "watch/seat-123".
EXTERNAL_PACS_WATCH_PATH=

# CORS (comma-separated, leave empty to allow all)
CORS_ALLOWED_ORIGINS=https://app.example.com,https://admin.example.com

# Orthanc
ORTHANC_URL=http://127.0.0.1:8042
ORTHANC_USERNAME=admin
ORTHANC_PASSWORD=change-me

# Nextcloud (required only for export route)
NEXTCLOUD_URL=https://nextcloud.example.com
NEXTCLOUD_USERNAME=svc-mapdr
NEXTCLOUD_PASSWORD=change-me
NEXTCLOUD_REJECT_UNAUTHORIZED=true

# Deleted case cleanup
# Soft-deleted cases are purged permanently after this window.
DELETED_STUDY_RETENTION_DAYS=7
DELETED_STUDY_SWEEP_INTERVAL_MS=3600000
# Poll Orthanc/PACS for studies that were deleted directly there and mirror the delete.
ORTHANC_DELETE_RECONCILE_INTERVAL_MS=900000

# Case stream image/video quality
# Lower CRF increases quality and file size. 16 preserves fine medical-image detail.
CASE_STREAM_X264_CRF=16
CASE_STREAM_X264_PRESET=veryfast
