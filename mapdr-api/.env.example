# Runtime
NODE_ENV=production
PORT=3001
JSON_LIMIT=2mb
HTTP_TIMEOUT_MS=15000
ORTHANC_UPLOAD_TIMEOUT_MS=300000
ORTHANC_UPLOAD_RETRIES=2
UPLOAD_MAX_MB=5120
UPLOAD_MAX_FILES=2000
DICOM_IN_MEMORY_MAX_MB=64
DICOM_UPLOAD_CONCURRENCY=4
SHARE_TTL_DAYS=7

# Public URLs
# Optional: if set, used by /api/viewer-link/:id
APP_BASE_URL=
OHIF_HOST=
SERVER_IP=127.0.0.1

# Optional: if set, /api/viewer-link/:id will open the external PACS instead of local OHIF.
# Typical reverse-proxy path: https://this-app.example.com/external-pacs
EXTERNAL_PACS_BASE_URL=
# Optional route under the external PACS base, for example "watch/seat-123".
EXTERNAL_PACS_WATCH_PATH=
# Patient profile lookup links are rendered as ${PATIENT_LOOKUP_BASE_URL}/lookup_<patient_identifier>.
PATIENT_LOOKUP_BASE_URL=https://pacs.octelerad.com

# CORS (comma-separated, leave empty to allow all)
CORS_ALLOWED_ORIGINS=https://app.example.com,https://admin.example.com,https://formchapter1.octelerad.com
FORM_SUBMISSIONS_API_KEY=replace-with-a-long-random-shared-secret
# Optional: lets admins pull historical/current submissions from the form app.
FORM_SUBMISSIONS_SOURCE_BASE_URL=https://formchapter1.octelerad.com
FORM_SUBMISSIONS_SOURCE_LIST_PATH=/api/admin/submissions
FORM_SUBMISSIONS_SOURCE_DETAIL_PATH=/api/admin/submissions/:id
FORM_SUBMISSIONS_SOURCE_USERNAME=
FORM_SUBMISSIONS_SOURCE_PASSWORD=
FORM_SUBMISSIONS_SOURCE_COOKIE=
FORM_SUBMISSIONS_SOURCE_BEARER_TOKEN=
FORM_SUBMISSIONS_SOURCE_API_KEY=
FORM_SUBMISSIONS_SOURCE_PAGE_LIMIT=100
FORM_SUBMISSIONS_SOURCE_MAX_PAGES=200
FORM_SUBMISSIONS_SOURCE_FETCH_DETAILS=true

# End-user two-factor authentication framework.
# Keep disabled until the auth UI is ready to enforce it during login.
TWO_FACTOR_AUTH_ENABLED=false
TWO_FACTOR_CODE_SECRET=replace-with-a-long-random-secret
TWO_FACTOR_CODE_TTL_MINUTES=10
TWO_FACTOR_CODE_MAX_ATTEMPTS=5
TWO_FACTOR_APP_NAME=MAPDR
# Resend email delivery for 2FA. These may reuse your existing RESEND_* values.
TWO_FACTOR_RESEND_API_KEY=
TWO_FACTOR_RESEND_FROM=
TWO_FACTOR_SEND_RATE_LIMIT_MAX=3
TWO_FACTOR_SEND_RATE_LIMIT_WINDOW_MS=600000
TWO_FACTOR_VERIFY_RATE_LIMIT_MAX=8
TWO_FACTOR_VERIFY_RATE_LIMIT_WINDOW_MS=600000

# Orthanc
ORTHANC_URL=http://127.0.0.1:8042
ORTHANC_USERNAME=admin
ORTHANC_PASSWORD=change-me

# Nextcloud (required only for export route)
NEXTCLOUD_URL=https://nextcloud.example.com
NEXTCLOUD_USERNAME=svc-mapdr
NEXTCLOUD_PASSWORD=change-me
NEXTCLOUD_REJECT_UNAUTHORIZED=true
# SOAP note PDF export
# Optional: override the logo embedded in reports/soap-clinical-note.pdf.
SOAP_TEMPLATE_LOGO_PATH=/root/mapdr-project/docker/ohif-orthanc/logo.png
# Optional: override the local Playwright module used to render the PDF.
PLAYWRIGHT_MODULE_PATH=/root/mapdr-project/frontend/mediview-portal/node_modules/playwright

# Grist completed-case logging
# Table ID uses Grist-safe characters; display/requested sheet name is TEST Sheet.
GRIST_BASE_URL=https://docs.getgrist.com
GRIST_API_KEY=change-me
GRIST_DOC_ID=change-me
GRIST_COMPLETED_CASES_TABLE_ID=TEST_Sheet
GRIST_COMPLETED_CASES_TABLE_NAME=TEST Sheet
GRIST_REPORT_CODES_TABLE_ID=Report_Codes
GRIST_REPORT_CODES_TABLE_NAME=Report Codes
GRIST_REPORT_CODES_DOC_ID=change-me
GRIST_REPORT_CODES_MONTH_KEY=2026-06
GRIST_ACRONYM_DOC_ID=change-me
GRIST_ACRONYM_TABLE_ID=change-me
GRIST_ACRONYM_TABLE_IDS=Table1,T6_SET_ACRONYM,OCTR_BEETS_SHEET_2_,OCTR_ADM_BETA_SHEET_DATA
GRIST_PROXY_BASIC_USERNAME=
GRIST_PROXY_BASIC_PASSWORD=
GRIST_ACRONYM_SYNC_INTERVAL_MS=3600000
GRIST_ACRONYM_INITIAL_SYNC_DELAY_MS=120000

# Deleted case cleanup
# Soft-deleted cases are purged permanently after this window.
DELETED_STUDY_RETENTION_DAYS=7
DELETED_STUDY_SWEEP_INTERVAL_MS=3600000
# Poll Orthanc/PACS for studies that were deleted directly there and mirror the delete.
ORTHANC_DELETE_RECONCILE_INTERVAL_MS=900000

# Case stream image/video quality
# Lower CRF increases quality and file size. 16 preserves fine medical-image detail.
CASE_STREAM_X264_CRF=16
CASE_STREAM_X264_PRESET=veryfast
